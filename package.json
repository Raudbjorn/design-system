{
  "name": "@svnbjrn/design",
  "version": "0.0.0",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "files": [
    "dist",
    "bin",
    "!dist/**/*.test.*"
  ],
  "bin": {
    "design-generate": "./bin/design-generate.mjs"
  },
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js"
    },
    "./styles.css": "./dist/tokens/index.css",
    "./tokens": {
      "types": "./dist/tokens/index.d.ts",
      "default": "./dist/tokens/index.js"
    },
    "./tokens/*.json": "./dist/tokens/resolved/*.json",
    "./qss/*.qss": "./dist/qss/*.qss",
    "./extjs": {
      "types": "./dist/extjs/index.d.ts",
      "default": "./dist/extjs/index.js"
    },
    "./extjs/*.css": "./dist/extjs/*.css",
    "./qt": {
      "types": "./dist/qt/index.d.ts",
      "default": "./dist/qt/index.js"
    },
    "./qt/*.json": "./dist/qt/*.json",
    "./astro": {
      "types": "./dist/astro/index.d.ts",
      "default": "./dist/astro/index.js"
    },
    "./astro/components": {
      "types": "./dist/astro/components/index.d.ts",
      "default": "./dist/astro/components/index.js"
    },
    "./astro/components/*.astro": "./dist/astro/components/*.astro",
    "./theme": {
      "types": "./dist/theme/index.d.ts",
      "default": "./dist/theme/index.js"
    },
    "./theme/svelte": {
      "types": "./dist/theme/svelte.svelte.d.ts",
      "svelte": "./dist/theme/svelte.svelte.js",
      "default": "./dist/theme/svelte.svelte.js"
    },
    "./generate": {
      "types": "./dist/generate/index.d.ts",
      "default": "./dist/generate/index.js"
    },
    "./vernacular": {
      "types": "./dist/vernacular/index.d.ts",
      "default": "./dist/vernacular/index.js"
    },
    "./vernacular/svelte": {
      "types": "./dist/vernacular/svelte.svelte.d.ts",
      "svelte": "./dist/vernacular/svelte.svelte.js",
      "default": "./dist/vernacular/svelte.svelte.js"
    },
    "./vermis": {
      "types": "./dist/vermis/index.d.ts",
      "svelte": "./dist/vermis/index.js",
      "default": "./dist/vermis/index.js"
    },
    "./vermis/styles.css": "./dist/vermis/tokens/index.css",
    "./carter": {
      "types": "./dist/carter/index.d.ts",
      "svelte": "./dist/carter/index.js",
      "default": "./dist/carter/index.js"
    },
    "./carter/styles.css": "./dist/carter/tokens/index.css"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "pnpm run tokens && pnpm run fonts && svelte-package && publint",
    "tokens": "node scripts/build-tokens.mjs",
    "fonts": "node scripts/build-fonts.mjs",
    "generate": "node bin/design-generate.mjs",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run --project=unit --project=astro",
    "test:watch": "vitest --project=unit --project=astro",
    "test:visual": "vitest run --project=storybook",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "tui:check": "cargo check --workspace --all-targets",
    "tui:test": "cargo test --workspace",
    "tui:gallery": "cargo run -p raudbjorn-tui --example gallery",
    "tui:list": "cargo run -p raudbjorn-tui --example gallery -- --list",
    "tui:smoke": "bash scripts/test-tui-determinism.sh"
  },
  "peerDependencies": {
    "svelte": "^5.0.0",
    "astro": "^5.0.0 || ^6.0.0 || ^7.0.0",
    "@astrojs/svelte": "^7.0.0 || ^8.0.0 || ^9.0.0"
  },
  "peerDependenciesMeta": {
    "astro": {
      "optional": true
    },
    "@astrojs/svelte": {
      "optional": true
    }
  },
  "devDependencies": {
    "@argos-ci/cli": "^6.1.0",
    "@argos-ci/storybook": "^6.0.16",
    "@astrojs/svelte": "^9.0.1",
    "@storybook/addon-a11y": "^10.4.6",
    "@storybook/addon-docs": "^10.4.6",
    "@storybook/addon-svelte-csf": "^5.1.2",
    "@storybook/addon-themes": "^10.4.6",
    "@storybook/addon-vitest": "^10.4.6",
    "@storybook/svelte-vite": "^10.4.6",
    "@sveltejs/package": "^2.3.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/svelte": "^5.2.0",
    "@types/culori": "^4.0.1",
    "@types/fontkit": "^2.0.9",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^24.0.0",
    "@vitest/browser-playwright": "^4.1.9",
    "astro": "^7.1.6",
    "culori": "^4.0.2",
    "fontkit": "^2.0.4",
    "jsdom": "^25.0.0",
    "playwright": "^1.61.1",
    "publint": "^0.2.0",
    "storybook": "^10.4.6",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "esm-env": "^1.2.2"
  }
}
